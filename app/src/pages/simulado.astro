---
import Layout from "../components/Layout.astro";
import TopBanner from "../components/TopBanner.astro";
import RibbonCard from "../components/RibbonCard.astro";
import Footer from "../components/Footer.astro";
import { subjectCards } from "../lib/subject-cards";

const cards = subjectCards();
---
<Layout title="Simulado — COER Classe C">
  <TopBanner label="SIMULADO" />
  <main>
    <p>
      O simulado replica a prova oficial da Anatel: <strong>15 questões certa/errado</strong>, <strong>20
      minutos</strong> e <strong>mínimo de 8 acertos (51%)</strong> por matéria. Escolha uma matéria para começar.
    </p>

    {cards.map((c) => (
      <RibbonCard
        title={c.title}
        tint={c.tint}
        meta={c.trueFalse ? `${c.trueFalse} questões certa/errado no banco` : "Em breve"}
        body={c.blurb}
        to={c.trueFalse ? `/simulado/${c.slug}` : undefined}
        disabled={!c.trueFalse}
      />
    ))}
  </main>
  <Footer />
</Layout>