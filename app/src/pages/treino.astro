---
import Layout from "../components/Layout.astro";
import TopBanner from "../components/TopBanner.astro";
import RibbonCard from "../components/RibbonCard.astro";
import Footer from "../components/Footer.astro";
import { readFileSync } from "node:fs";
import type { Bank } from "../../scripts/schema";

function total(subject: string): number | null {
  try {
    const bank = JSON.parse(readFileSync(`public/data/${subject}.json`, "utf8")) as Bank;
    return bank.questions.length;
  } catch {
    return null;
  }
}
const teo = total("teo");
---
<Layout title="Treino — COER Classe C">
  <TopBanner label="TREINO" />
  <main>
    <p>
      Treine <strong>por assunto da ementa</strong>, escolhendo entre <strong>certa/errado</strong>,{" "}
      <strong>múltipla escolha</strong> (uma resposta correta) ou <strong>misto 50/50</strong>. Aqui
      cada resposta vem com explicação imediata, sem nota mínima.
    </p>

    <RibbonCard
      title="Técnica e Ética Operacional"
      tint="lime"
      meta={teo ? `${teo} questões no banco` : "em construção"}
      body="Todas as áreas da ementa: estação, antenas, frequência, propagação, interferências, comunicados, ética e emergências."
      to="/treino/teo"
    />

    <RibbonCard title="Legislação de Telecomunicações" tint="sky" meta="Em breve" disabled />
    <RibbonCard title="Conhecimentos Básicos de Eletrônica e Eletricidade" tint="steel" meta="Em breve" disabled />
  </main>
  <Footer />
</Layout>